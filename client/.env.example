# Haven Space Frontend Environment Configuration
# Copy this file to .env and customize for your environment

# API Base URL - Override environment detection
# Format: http://localhost:8000 for local development
#         https://haven-space.appwrite.network for production
VITE_API_BASE_URL=

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=69eae504002697b6749c
VITE_APPWRITE_FUNCTION_ID=api-function

# Environment-specific overrides (optional)
# VITE_ENV=production  # Can be: production, local-dev, local-apache

# Debug settings
VITE_DEBUG=false
