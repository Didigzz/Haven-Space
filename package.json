{
  "name": "haven-space",
  "version": "1.0.0",
  "type": "module",
  "description": "Boarding house platform connecting boarders and landlords",
  "main": "index.js",
  "scripts": {
    "dev": "bun run web:dev",
    "start": "bun run web:dev",
    "server": "bun run cf:api:dev",
    "db:setup": "bun run --cwd workers/api migrate:local",
    "db:reset": "echo \"D1 reset is manual. Delete/recreate the local D1 database, then run bun run db:setup.\"",
    "db:reset:force": "echo \"D1 reset is manual. Delete/recreate the local D1 database, then run bun run db:setup.\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "bun run cf:api:deploy && bun run web:deploy",
    "cf:api:dev": "bun run --cwd workers/api dev",
    "cf:api:deploy": "bun run --cwd workers/api deploy",
    "cf:api:deploy:staging": "bun run --cwd workers/api deploy:staging",
    "cf:api:typecheck": "bun run --cwd workers/api typecheck",
    "cf:api:test": "bun run --cwd workers/api test",
    "client:dev": "bunx serve client -l 8788",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:deploy": "bun run --cwd apps/web deploy",
    "web:test": "bun run --cwd apps/web test",
    "web:typecheck": "bun run --cwd apps/web typecheck",
    "prepare": "husky install"
  },
  "keywords": [
    "boarding-house",
    "rental",
    "philippines",
    "property-management"
  ],
  "author": "Haven Space Team",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8"
  },
  "lint-staged": {
    "workers/api/**/*.{ts,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.{ts,html,css,scss,md,json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
