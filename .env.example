# Haven Space Backend Environment Configuration
# Copy this file to .env and customize for your environment

# Application Base URL
APP_BASE_URL=http://localhost:8000

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://haven-space.appwrite.network,http://localhost:3000,http://localhost:8000

# Security and Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# Database Configuration
DB_HOST=localhost
DB_NAME=haven_space
DB_USER=root
DB_PASSWORD=

# Appwrite Configuration
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69eae504002697b6749c
APPWRITE_FUNCTION_ID=api-function

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@haven-space.com

# Environment
APP_ENV=local

# Debug settings
APP_DEBUG=true
